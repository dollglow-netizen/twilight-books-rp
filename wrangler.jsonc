{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "twilight-books-rp",

  "main": "worker.js",

  "compatibility_date": "2026-09-25",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "ai": {
    "binding": "AI"
  }
}
